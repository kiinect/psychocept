    const s = new Sim([{ x: 0, y: 0 }, { x: 1000, y: 0 }]);
    s.addTower(100, 50); s.towers[0].range = 100; s.towers[0].targeting = mode;
    s.bloons.push({ id: 1, type: 'red', dist: 120, hp: 1 }, { id: 2, type: 'red', dist: 100, hp: 1 }, { id: 3, type: 'moab', dist: 80, hp: 200 });
