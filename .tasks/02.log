    tier('Spike-o-pult', 320, { damage: 2, pierce: 18, cooldown: 1.15, range: 36.8, projectileSpeed: 150, lifespan: 1, frozen: true, bounce: true }),
    // The prose gives no numeric speed/lifetime for Juggernaut; retain Spike-o-pult values.
    tier('Juggernaut', 1800, { damage: 2, pierce: 60, cooldown: 1, range: 36.8, projectileSpeed: 150, lifespan: 1, frozen: true, lead: true, bounce: true, knockback: true, ceramicBonus: 3, fortifiedBonus: 2 }),
    tier('Ultra-Juggernaut', 15000, { damage: 5, pierce: 210, cooldown: 1, range: 36.8, projectileSpeed: 150, lifespan: 1, frozen: true, lead: true, bounce: true, knockback: true, split: true, ceramicBonus: 8, fortifiedBonus: 5, leadBonus: 20 }),
  ],
  [
    tier('Quick Shots', 100, { cooldown: 0.8075 }),
    tier('Very Quick Shots', 190, { cooldown: 0.95 * 2 / 3 }),
    tier('Triple Shot', 450, { cooldown: 0.475, projectiles: 3, spread: 15 }),
    tier('Super Monkey Fan Club', 7200, { cooldown: 0.2375, projectiles: 3, spread: 15, fanClub: 10 }),
    tier('Plasma Monkey Fan Club', 45000, { cooldown: 0.2375, projectiles: 3, spread: 15, fanClub: 20 }),
  ],
  [
    tier('Long Range Darts', 90, { range: 40, lifespan: 0.3375 }),
    tier('Enhanced Eyesight', 200, { range: 48, lifespan: 0.3375, projectileSpeed: 350, camo: true }),
    tier('Crossbow', 575, { damage: 3, pierce: 5, range: 60, lifespan: 0.3375, projectileSpeed: 350, camo: true }),
    tier('Sharp Shooter', 2050, { damage: 6, pierce: 5, cooldown: 0.475, range: 60, lifespan: 0.3375, projectileSpeed: 350 * 4 / 3, camo: true, critEvery: 10, critDamage: 60 }),
    tier('Crossbow Master', 21500, { damage: 8, pierce: 8, cooldown: 0.475, range: 80, lifespan: 0.3375, projectileSpeed: 350 * 4 / 3, camo: true, lead: true, frozen: true, projectiles: 2, critEvery: 5, critDamage: 80 }),
  ],
];
export function canUpgrade(tiers: Tiers, path: number): boolean {
  if (!Number.isInteger(path) || path < 0 || path > 2) return false;
  const next = [...tiers]; next[path]++;
  return next.every(n => n >= 0 && n <= 5) && next.filter(n => n > 0).length <= 2 && next.filter(n => n > 2).length <= 1;
}
export function dartStats(tiers: Tiers): DartStats {
  const [a, b, c] = tiers;
  const main = a >= 3 ? 0 : c >= 3 ? 2 : b >= 3 ? 1 : -1;
  const stats = { ...(main < 0 ? BASE : DART_TIERS[main][(main === 0 ? a : main === 1 ? b : c) - 1].stats) };
  if (main !== 0 && a) stats.pierce += c === 5 ? 8 : c >= 3 ? (a === 1 ? 3 : 8) : (a === 1 ? 1 : 3);
  if (main !== 1 && b) stats.cooldown *= DART_TIERS[1][b - 1].stats.cooldown / BASE.cooldown;
  if (main !== 2 && c) {
    stats.range += c * 8; stats.lifespan *= 1.35;
    if (c === 2) { stats.camo = true; stats.projectileSpeed *= 7 / 6; }
  }
  return stats;
}
import { test, expect } from 'vitest';
import { Sim, ROUNDS, BLOONS } from './sim';
import rounds from '../data/wiki/rounds.json';

test('dart monkey pops early waves', () => {
  const s = new Sim([{ x: 0, y: 100 }, { x: 800, y: 100 }]);
  expect(s.addTower(400, 110)).toBe(true);
  s.startRound([{ type: 'red', n: 10, gap: 1.5 }]);
  for (let i = 0; i < 60 * 60; i++) s.step();
  expect(s.bloons.length).toBe(0); expect(s.lives).toBe(150);
});
test('every round group has a known bloon type', () => {
  for (const r of ROUNDS) for (const g of r.groups) expect(BLOONS[g.type], g.type).toBeDefined();
});
test('round RBE (base) matches table for rounds 1-80', () => {
  ROUNDS.slice(0, 80).forEach((r, i) => {
    const sum = r.groups.reduce((a, g) => a + g.count * BLOONS[g.type].rbe, 0); // ignores fortified
    const row: any = rounds.data.rounds[i];
    if (!r.groups.some(g => g.fortified)) expect(sum, `round ${i + 1}`).toBe(row.rbe_base);
  });
});

test('all fifteen Dart upgrades can be purchased and fire', () => {
  for (let path = 0; path < 3; path++) for (let tier = 1; tier <= 5; tier++) {
    const s = new Sim([{ x: 0, y: 100 }, { x: 1000, y: 100 }]);
    s.cash = 1000000; s.addTower(100, 110);
    for (let n = 0; n < tier; n++) expect(s.upgrade(0, path)).toBe(true);
    s.bloons.push({ id: 999, type: 'moab', dist: 120, hp: 200 });
    s.step();
    expect(s.darts.length, `path ${path}, tier ${tier}`).toBeGreaterThan(0);
  }
});

test('crosspaths allow 5/2/0 and reject third paths and two tier threes', () => {
  const s = new Sim([{ x: 0, y: 0 }, { x: 1000, y: 0 }]);
  s.cash = 1000000; s.addTower(100, 10);
  for (let n = 0; n < 5; n++) expect(s.upgrade(0, 0)).toBe(true);
  expect(s.upgrade(0, 0)).toBe(false);
  expect(s.upgrade(0, 1)).toBe(true); expect(s.upgrade(0, 1)).toBe(true);
  const cash = s.cash;
  expect(s.upgrade(0, 1)).toBe(false); expect(s.upgrade(0, 2)).toBe(false);
  expect(s.cash).toBe(cash);
});

test('selling refunds seventy percent of all actual spending once', () => {
  const s = new Sim([{ x: 0, y: 0 }, { x: 1000, y: 0 }]);
  s.addTower(100, 10); s.upgrade(0, 0);
  const cash = s.cash;
  expect(s.sell(0)).toBe(true); expect(s.cash - cash).toBe(238);
  expect(s.sell(0)).toBe(false);
});

test('round completion pays 100 plus round once and prevents overlapping rounds', () => {
  const s = new Sim([{ x: 0, y: 0 }, { x: 1, y: 0 }]);
  expect(s.startRound([{ type: 'red', n: 1, gap: 1 }])).toBe(true);
  expect(s.startRound([])).toBe(false);
  for (let i = 0; i < 10; i++) s.step();
  expect(s.cash).toBe(751); expect(s.roundActive).toBe(false); expect(s.round).toBe(1);
});

test('difficulty costs round upward to five and modes set lives', () => {
  for (const [mode, cost, lives] of [['easy', 170, 200], ['medium', 200, 150], ['hard', 220, 100], ['impoppable', 240, 1]] as const) {
    const s = new Sim([{ x: 0, y: 0 }, { x: 1000, y: 0 }], mode);
    expect(s.lives).toBe(lives); expect(s.cash).toBe(650);
