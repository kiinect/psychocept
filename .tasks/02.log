      const aim = t.kind === 'tack' ? n * Math.PI * 2 / t.projectiles : angle + (n - (t.projectiles - 1) / 2) * t.spread * Math.PI / 180;
      const offset = t.projectiles === 2 ? (n === 0 ? -3 : 3) : 0;
