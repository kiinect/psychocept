      if (b.glue && b.glue.until <= this.tick) b.glue = undefined;
      if (b.glue && b.glue.stats.dotDamage && b.glue.next <= this.tick) {
        const stats = b.glue.stats;
        b.glue.next += stats.dotInterval * 60;
